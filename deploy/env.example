# Copy this file to deploy/env.local before running deploy-all.ps1.

# Deployment settings
SAE_APP_ID=replace-with-your-sae-app-id
ALIYUN_REGION=us-west-1
ACR_REGISTRY=replace-with-your-acr-registry
ACR_USERNAME=replace-with-your-acr-username
ACR_PASSWORD=replace-with-your-acr-password
REMOTE_IMAGE=replace-with-your-remote-image

# Application runtime environment variables
MYSQL_HOST=replace-with-your-mysql-host
MYSQL_DB=play-forge
MYSQL_USERNAME=replace-with-your-mysql-username
MYSQL_PASSWORD=replace-with-your-mysql-password

REDIS_HOST=replace-with-your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-your-redis-password

OSS_ENDPOINT=replace-with-your-oss-endpoint
OSS_BUCKET_NAME=replace-with-your-oss-bucket
OSS_ACCESS_KEY_ID=replace-with-your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-oss-access-key-secret

JWT_SECRET=replace-with-your-jwt-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
TAVILY_API_KEY=replace-with-your-tavily-api-key

# Optional Gemini document normalization settings
DOCUMENT_CONVERTER_BASE_URL=https://generativelanguage.googleapis.com
DOCUMENT_CONVERTER_MODEL_NAME=gemini-3.1-flash-lite-preview
DOCUMENT_CONVERTER_TIMEOUT=180s
DOCUMENT_UPLOAD_MAX_FILE_SIZE=20MB
DOCUMENT_UPLOAD_MAX_REQUEST_SIZE=20MB
